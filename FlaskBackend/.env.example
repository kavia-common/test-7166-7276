# Example environment variables for FlaskBackend
# All variables are optional. If MONGO_URI is omitted, the app starts with an in-memory repository.

# MongoDB connection string (optional)
# MONGO_URI=mongodb://localhost:27017

# Database and collection names (used only if MONGO_URI is set)
# DB_NAME=devices_db
# COLLECTION_NAME=devices
# AUDIT_COLLECTION_NAME=audit_logs

# Flask host/port (optional)
# FLASK_HOST=0.0.0.0
# FLASK_PORT=5000
