# Flask Backend configuration
# Copy this file to ".env" and adjust values as needed.
# These values are OPTIONAL for starting the app. If MONGO_URI is not set,
# the app will run with an in-memory repository (no persistence).

# MongoDB connection string (e.g., mongodb://localhost:27017)
# MONGO_URI=mongodb://localhost:27017

# Database and collection names (used when MONGO_URI is set)
DB_NAME=devices_db
COLLECTION_NAME=devices
AUDIT_COLLECTION_NAME=audit_logs

# Flask server settings
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
